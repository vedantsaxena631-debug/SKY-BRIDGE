{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SkyBridge: Start Server & Web Dashboard",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "SkyBridge: Test LoRa Hardware Link (COM8 <-> COM14)",
      "type": "shell",
      "command": "npx tsx scripts/testHardwareLink.ts",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "SkyBridge: List Connected Serial Ports",
      "type": "shell",
      "command": "node -e \"const { SerialPort } = require('serialport'); SerialPort.list().then(p => console.table(p.map(x => ({ Port: x.path, Device: x.friendlyName || x.manufacturer }))));\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "SkyBridge: Run Automated Test Suite",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SkyBridge: Run Data Integrity Proof",
      "type": "shell",
      "command": "npm run verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
